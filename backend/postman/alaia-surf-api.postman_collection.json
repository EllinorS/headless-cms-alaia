          }
        },
        {
          "name": "POST /api/forms/:formId/fields (SUPER_ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"label\": \"What is your surf level?\",\n  \"type\": \"SINGLE\",\n  \"displayType\": \"CARDS\",\n  \"position\": 0,\n  \"isRequired\": true\n}" },
            "url": { "raw": "{{baseUrl}}/api/forms/{{formId}}/fields", "host": ["{{baseUrl}}"], "path": ["api", "forms", "{{formId}}", "fields"] },
            "description": "type: SINGLE | MULTIPLE | RANK | TEXT. displayType: CARDS | SLIDER | CHECKBOX | RADIO."
          }
        },
        {
          "name": "GET /api/forms/fields/:id (SUPER_ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/forms/fields/{{fieldId}}", "host": ["{{baseUrl}}"], "path": ["api", "forms", "fields", "{{fieldId}}"] }
          }
        },
        {
          "name": "PUT /api/forms/fields/:id (SUPER_ADMIN)",
          "request": {
            "method": "PUT",
